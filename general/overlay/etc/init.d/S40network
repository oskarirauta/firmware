#!/bin/sh
dev=$(fw_printenv -n wlandev)
mac=$(fw_printenv -n wlanmac)
net=$(fw_printenv -n netaddr_fallback)
eth=$(fw_printenv -n ethaddr)

set_wireless() {
	path=/etc/wireless
	if $path/usb "$dev" || $path/sdio "$dev"; then
		[ -n "$mac" ] && ip link set dev wlan0 address "$mac"
		ifup wlan0
	elif $path/modem "$dev"; then
		ifup usb0
		ifup eth1
	fi
	if [ -e /sys/class/net/eth0 ]; then
		# A hardware address can only be set while the interface is down, and
		# assigning an IPv4 address brings it up. Doing both in one ifconfig
		# call therefore never worked: the address went on first, the
		# interface came up with it, and hw ether then failed with EBUSY,
		# leaving the random MAC the driver invents at every boot.
		#
		# The fallback MAC is deliberately gone with it. Once hw ether
		# actually takes effect, a shared default would put the same address
		# on every camera that has no ethaddr - worse than the random one
		# they get today, because those at least do not collide.
		if [ -n "$eth" ]; then
			ifconfig eth0 down
			ifconfig eth0 hw ether "$eth"
		fi
		ifconfig eth0 "${net:-192.168.2.10}" up
	fi
}

start() {
	echo "Starting network..."
	ifup lo
	if [ -n "$dev" ]; then
		set_wireless
	else
		ifup eth0
	fi
}

stop() {
	echo "Stopping network..."
	ifdown lo
	ifdown -f wlan0
	ifdown -f usb0
	ifdown -f eth1
	ifdown -f eth0
}

case "$1" in
	start|stop)
		$1
		;;

	restart|reload)
		stop
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
