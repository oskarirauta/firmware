iface wlan0 inet dhcp
    pre-up wpa_passphrase "$(fw_printenv -n wlanssid)" "$(fw_printenv -n wlanpass)" > /tmp/wpa_supplicant.conf
    pre-up sed -i 's/#psk.*/scan_ssid=1/g' /tmp/wpa_supplicant.conf
    pre-up wpa_supplicant -B -i wlan0 -D nl80211,wext -c /tmp/wpa_supplicant.conf
    # wpa_supplicant -B returns as soon as it has forked, long before the card
    # has associated, and udhcpc starts immediately after. It is given five
    # tries a second apart and then goes to the background lease-less, so a
    # slow association means the boot finishes with no address even though the
    # network is perfectly fine a moment later. Wait for the link instead of
    # widening the DHCP window: this costs only the association time, and
    # nothing at all when the card is already up.
    pre-up i=0; while [ "$(cat /sys/class/net/wlan0/carrier 2>/dev/null)" != "1" ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
    post-down killall -q wpa_supplicant
