#!/bin/sh
#
# daynight - switch the camera between day and night.
#
#   daynight day | night | status
#
# Three things have to move together on this hardware, and this is the one place
# that owns all three:
#
#   the IR-cut filter   a latching solenoid on two GPIOs, pulsed to move it
#   the IR illuminator  on at night, off during the day
#   the ISP             its own day/night tuning, which is what turns the image
#                       greyscale and changes the noise handling
#
# It is not done in majestic, and that is deliberate. majestic's nightMode drives
# the IR-cut pins itself when they are configured, but the ISP half of the switch
# is missing on Ingenic: its only route is IMP_ISP_Tuning_SetISPRunningMode, and
# on T41 that faults inside libimp - it gets past get_isptuningdev() and then
# reads through a bogus pointer, which was confirmed by disassembly, not guessed.
# majestic also passes 0 in that call every time, day or night, so even
# intercepting it yields no mode to act on.
#
# So majestic's irCutPin1/irCutPin2 are deliberately left unset. Two owners
# pulsing the same solenoid would fight, and a half-applied switch - filter moved
# but ISP not, or the reverse - is worse than either state.
#
# The GPIO numbers come from the U-Boot environment rather than from here, so one
# image serves boards that wire them differently:
#
#   gpio_ircut=49 50    the two solenoid pins
#   gpio_ir850=81       the IR illuminator
#
# The GPIO idiom - export, direction, active_low, then a 10 ms pulse - follows
# ingenic-osdrv-t31's ircut_demo, which drives the same two pins on the same SoC
# family.

ISP_DAYNIGHT=/sys/module/tx_isp_t41/parameters/daynight
GPIO=/sys/class/gpio

die() {
	echo "daynight: $*" >&2
	exit 1
}

# Read a variable out of the U-Boot environment, quietly: a board that does not
# set one simply does not have that piece of hardware.
env_get() {
	fw_printenv -n "$1" 2>/dev/null
}

gpio_out() {
	[ -d "$GPIO/gpio$1" ] || echo "$1" >"$GPIO/export" 2>/dev/null
	[ -d "$GPIO/gpio$1" ] || return 1
	echo out >"$GPIO/gpio$1/direction" 2>/dev/null
	echo 0 >"$GPIO/gpio$1/active_low" 2>/dev/null
	return 0
}

gpio_set() {
	echo "$2" >"$GPIO/gpio$1/value" 2>/dev/null
}

# Move the filter. The solenoid latches, so it is driven only long enough to
# throw and then released - holding it would burn the coil.
#
# Which pin means which way is a property of the board's wiring and is not
# discoverable from software. If day and night come out swapped on some unit,
# exchange the two numbers in gpio_ircut rather than editing this.
ircut() {
	set -- $(env_get gpio_ircut)
	[ -n "$1" ] && [ -n "$2" ] || return 0

	gpio_out "$1" || { echo "daynight: cannot claim gpio $1" >&2; return 1; }
	gpio_out "$2" || { echo "daynight: cannot claim gpio $2" >&2; return 1; }

	gpio_set "$1" 0
	gpio_set "$2" 0
	usleep 10000
	if [ "$MODE" = night ]; then
		gpio_set "$1" 0
		gpio_set "$2" 1
	else
		gpio_set "$1" 1
		gpio_set "$2" 0
	fi
	usleep 10000
	gpio_set "$1" 0
	gpio_set "$2" 0
}

illuminator() {
	pin=$(env_get gpio_ir850)
	[ -n "$pin" ] || return 0

	gpio_out "$pin" || { echo "daynight: cannot claim gpio $pin" >&2; return 1; }

	# Spelled out rather than "test && on || off": a failing write to the "on"
	# branch would make the || fire and turn the illuminator off instead.
	if [ "$MODE" = night ]; then
		gpio_set "$pin" 1
	else
		gpio_set "$pin" 0
	fi
}

# The ISP's own switch. 0 day, 1 night - the driver's numbering, exposed as a
# module parameter because libimp's userspace route into it is broken. Writing it
# takes effect on the live stream immediately, but only once the pipeline is
# running: the firmware setter indexes a per-instance table that does not exist
# before then, so a write while the stream is down is skipped rather than risked.
isp() {
	[ -w "$ISP_DAYNIGHT" ] || return 0
	[ -e /proc/jz/isp ] || return 0

	if [ "$MODE" = night ]; then
		echo 1 >"$ISP_DAYNIGHT"
	else
		echo 0 >"$ISP_DAYNIGHT"
	fi
}

# The ambient-light reading. Channel 0 is where the photoresistor sits, and the
# driver hands back a binary unsigned long rather than text, so od converts it.
#
# POLARITY IS A CONTRACT: everything here assumes **higher means brighter**. That
# is how this camera reads - measured by pointing a lamp at it and watching the
# value rise. A board wired the other way round is normalised in the driver, not
# here: ingenic_adc_aux takes an `invert` parameter which returns
# (invert - reading), so setting it to just above full scale flips a
# bright-is-low sensor into this convention and leaves the thresholds meaningful.
#
# The reading is noisy - a stable scene wanders over tens of units, and the raw
# ADC step is about 4.3 of them - so a single sample must never decide anything.
ADC=/dev/ingenic_adc_aux_0
ADC_SAMPLES=9

adc_read() {
	[ -r "$ADC" ] || return 1
	od -An -tu4 -N4 "$ADC" 2>/dev/null | tr -d ' \n'
}

# The median of several samples, not the mean: one wild reading shifts a mean but
# cannot move a median, and wild readings are exactly what this sensor produces.
adc_level() {
	[ -r "$ADC" ] || return 1
	i=0
	while [ $i -lt $ADC_SAMPLES ]; do
		adc_read
		echo
		i=$((i + 1))
	done | sort -n | sed -n "$(( (ADC_SAMPLES + 1) / 2 ))p"
}

# Decide from the light level. Two thresholds rather than one, with a dead band
# between them, so a value sitting near the boundary cannot throw the filter back
# and forth - each crossing costs a solenoid pulse and a visible jump in the
# picture. Both are overridable from the U-Boot environment, because the right
# numbers depend on the lens, the housing and where the camera is pointed.
#
# They are MANDATORY, with no defaults, and that is the safety property rather
# than an omission. A camera whose photoresistor is not fitted reads a steady
# near-zero - measured on this one, 4 to 35 units, which is 1 to 8 raw counts of
# 4096 and does not move when the room lights go out. A working sensor spans
# almost the whole 18000-unit scale. Any built-in threshold would therefore read
# an absent sensor as pitch darkness and drive the camera to night in daylight,
# which is exactly what a first attempt with invented defaults did.
auto() {
	value=$(adc_level)
	case "$value" in
	''|*[!0-9]*)
		die "no usable reading from $ADC - is a light sensor fitted?"
		;;
	esac

	night_below=$(env_get dn_night_below)
	day_above=$(env_get dn_day_above)
	if [ -z "$night_below" ] || [ -z "$day_above" ]; then
		die "auto needs thresholds: set dn_night_below and dn_day_above with
       fw_setenv, after reading the light with '$(basename "$0") adc' in the
       dark and in daylight. There are deliberately no defaults - a camera
       with no photoresistor fitted reads a steady near-zero, which any
       default would read as pitch darkness and switch to night at noon."
	fi

	now=$(current_mode)
	if [ "$value" -lt "$night_below" ]; then
		want=night
	elif [ "$value" -gt "$day_above" ]; then
		want=day
	else
		want=$now		# in the dead band: leave it where it is
	fi

	[ "$want" = "$now" ] && return 0
	MODE=$want
	ircut
	illuminator
	isp
	echo "daynight: light $value -> $want"
}

current_mode() {
	if [ -r "$ISP_DAYNIGHT" ] && [ "$(cat "$ISP_DAYNIGHT")" = 1 ]; then
		echo night
	else
		echo day
	fi
}

status() {
	if [ -r "$ISP_DAYNIGHT" ]; then
		printf 'mode      : %s\n' "$(current_mode)"
	else
		printf 'mode      : unknown (no %s)\n' "$ISP_DAYNIGHT"
	fi
	printf 'light     : %s\n' "$(adc_level || echo 'no sensor')"
	printf 'ircut pins: %s\n' "$(env_get gpio_ircut || echo unset)"
	printf 'ir850 pin : %s\n' "$(env_get gpio_ir850 || echo unset)"
}

case "$1" in
day|night)
	MODE=$1
	ircut
	illuminator
	isp
	;;
auto)
	auto
	;;
adc)
	adc_level || die "no reading from $ADC"
	;;
status)
	status
	;;
*)
	echo "usage: $(basename "$0") day|night|auto|adc|status" >&2
	exit 2
	;;
esac
