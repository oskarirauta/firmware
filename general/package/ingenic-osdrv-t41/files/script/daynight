#!/bin/sh
#
# daynight - switch the camera between day and night.
#
#   daynight day | night | auto | light | status
#
# Three things have to move together on this hardware, and this is the one place
# that owns all three:
#
#   the IR-cut filter   a latching solenoid on two GPIOs, pulsed to move it
#   the IR illuminator  on at night, off during the day
#   the ISP             its own day/night tuning, which is what turns the image
#                       greyscale and changes the noise handling
#
# It is not done in majestic, and that is deliberate. majestic's nightMode drives
# the IR-cut pins itself when they are configured, but the ISP half of the switch
# is missing on Ingenic: its only route is IMP_ISP_Tuning_SetISPRunningMode, and
# on T41 that faults inside libimp - it gets past get_isptuningdev() and then
# reads through a bogus pointer, which was confirmed by disassembly, not guessed.
# majestic also passes 0 in that call every time, day or night, so even
# intercepting it yields no mode to act on.
#
# So majestic's irCutPin1/irCutPin2 are deliberately left unset. Two owners
# pulsing the same solenoid would fight, and a half-applied switch - filter moved
# but ISP not, or the reverse - is worse than either state.
#
# The GPIO numbers come from the U-Boot environment rather than from here, so one
# image serves boards that wire them differently:
#
#   gpio_ircut=49 50    the two solenoid pins
#   gpio_ir850=81       the IR illuminator
#
# The GPIO idiom - export, direction, active_low, then a 10 ms pulse - follows
# ingenic-osdrv-t31's ircut_demo, which drives the same two pins on the same SoC
# family.

ISP_DAYNIGHT=/sys/module/tx_isp_t41/parameters/daynight
GPIO=/sys/class/gpio

die() {
	echo "daynight: $*" >&2
	exit 1
}

# Read a variable out of the U-Boot environment, quietly: a board that does not
# set one simply does not have that piece of hardware.
env_get() {
	fw_printenv -n "$1" 2>/dev/null
}

gpio_out() {
	[ -d "$GPIO/gpio$1" ] || echo "$1" >"$GPIO/export" 2>/dev/null
	[ -d "$GPIO/gpio$1" ] || return 1
	echo out >"$GPIO/gpio$1/direction" 2>/dev/null
	echo 0 >"$GPIO/gpio$1/active_low" 2>/dev/null
	return 0
}

gpio_set() {
	echo "$2" >"$GPIO/gpio$1/value" 2>/dev/null
}

# Move the filter. The solenoid latches, so it is driven only long enough to
# throw and then released - holding it would burn the coil.
#
# Which pin means which way is a property of the board's wiring and is not
# discoverable from software. If day and night come out swapped on some unit,
# exchange the two numbers in gpio_ircut rather than editing this.
ircut() {
	set -- $(env_get gpio_ircut)
	[ -n "$1" ] && [ -n "$2" ] || return 0

	gpio_out "$1" || { echo "daynight: cannot claim gpio $1" >&2; return 1; }
	gpio_out "$2" || { echo "daynight: cannot claim gpio $2" >&2; return 1; }

	gpio_set "$1" 0
	gpio_set "$2" 0
	usleep 10000
	if [ "$MODE" = night ]; then
		gpio_set "$1" 0
		gpio_set "$2" 1
	else
		gpio_set "$1" 1
		gpio_set "$2" 0
	fi
	usleep 10000
	gpio_set "$1" 0
	gpio_set "$2" 0
}

illuminator() {
	pin=$(env_get gpio_ir850)
	[ -n "$pin" ] || return 0

	gpio_out "$pin" || { echo "daynight: cannot claim gpio $pin" >&2; return 1; }

	# Spelled out rather than "test && on || off": a failing write to the "on"
	# branch would make the || fire and turn the illuminator off instead.
	if [ "$MODE" = night ]; then
		gpio_set "$pin" 1
	else
		gpio_set "$pin" 0
	fi
}

# The ISP's own switch. 0 day, 1 night - the driver's numbering, exposed as a
# module parameter because libimp's userspace route into it is broken. Writing it
# takes effect on the live stream immediately, but only once the pipeline is
# running: the firmware setter indexes a per-instance table that does not exist
# before then, so a write while the stream is down is skipped rather than risked.
isp() {
	[ -w "$ISP_DAYNIGHT" ] || return 0
	[ -e /proc/jz/isp ] || return 0

	if [ "$MODE" = night ]; then
		echo 1 >"$ISP_DAYNIGHT"
	else
		echo 0 >"$ISP_DAYNIGHT"
	fi
}

# How dark is it?
#
# ONE CONVENTION, AND BOTH SOURCES FIT IT NATURALLY: **higher means darker**.
# That is not a choice, it is what the hardware gives.
#
#   gain  the ISP's own auto-exposure analog gain, from /proc/jz/isp. It rises as
#         the scene darkens - that is what gain is for. Available on every camera
#         because it needs no extra component, so it is the default. It is also
#         the quantity majestic documents its own minThreshold/maxThreshold as
#         being compared against, and the same number the web UI shows.
#
#   adc   a photoresistor on SADC channel 0. Raw, it reads low in bright light and
#         close to full scale in the dark, so it is already dark-high and needs no
#         inversion here. The driver's `invert` parameter exists for majestic's
#         adcReadout, which wants the opposite sense; leave it at 0 for this.
#
# Because both are dark-high, one threshold pair serves either source and there is
# no polarity to get wrong.
ADC=/dev/ingenic_adc_aux_0
ISP_PROC=/proc/jz/isp
SAMPLES=9
SAMPLE_GAP=200000		# 0.2 s, so the samples span about 1.6 s

# Where the switching state lives. Deliberately on tmpfs: it is rewritten on
# every tick, and putting a once-a-minute write on a NOR flash would wear it out
# for nothing. Losing it across a reboot costs one extra confirmation period.
STATE=/tmp/daynight.state

adc_sample() {
	[ -r "$ADC" ] || return 1
	# A binary unsigned long, not text, so od converts it.
	od -An -tu4 -N4 "$ADC" 2>/dev/null | tr -d ' \n'
}

gain_sample() {
	[ -d "$ISP_PROC" ] || return 1
	awk '/^AeAGain /{print $3; exit}' "$ISP_PROC"/* 2>/dev/null
}

# Which source to use. Defaults to gain, which works without a photoresistor;
# set dn_source=adc on a camera that has one and prefers it.
darkness_source() {
	src=$(env_get dn_source)
	[ -n "$src" ] || src=gain
	echo "$src"
}

# The median of several samples rather than one, and a median rather than a mean:
# both readings wander, and one outlier must not be able to pulse the solenoid.
#
# The samples are SPACED IN TIME, which is the whole point of taking several. Read
# back to back they arrive inside a millisecond or two; the ADC would at least
# still give a fresh conversion each time, but the gain is one number in a proc
# file that the ISP updates per frame, so nine immediate reads return the same
# value nine times and the median smooths nothing at all.
darkness() {
	src=$(darkness_source)
	i=0
	while [ $i -lt $SAMPLES ]; do
		case "$src" in
		adc)	adc_sample ;;
		gain)	gain_sample ;;
		*)	return 1 ;;
		esac
		echo
		i=$((i + 1))
		[ $i -lt $SAMPLES ] && usleep $SAMPLE_GAP
	done | grep -E '^[0-9]+$' | sort -n | sed -n "$(( (SAMPLES + 1) / 2 ))p"
}

# Decide from how dark it is. Two thresholds with a dead band between them, so a
# value sitting near the boundary cannot throw the filter back and forth - each
# crossing costs a solenoid pulse and a visible jump in the picture.
#
# The thresholds are MANDATORY, with no defaults, and that is a safety property
# rather than an omission. Their right values depend on the source, the lens, the
# housing and where the camera points; and a camera whose photoresistor is not
# fitted reads a steady near-zero - measured on one here, 4 to 35 units, which is
# 1 to 8 raw counts of 4096 and does not move when the room lights go out. Any
# built-in number would read that as broad daylight or pitch darkness depending on
# its sense, and act on it. A first attempt with invented defaults did exactly
# that and drove the camera to night at noon.
# State, kept as three whitespace-separated fields: when the last switch happened,
# which way the readings are currently leaning, and for how many ticks running.
# "-" rather than an empty field for "leaning nowhere". An empty middle field
# would vanish in the word splitting on the way back in, shifting the count into
# the candidate - which read back as a lean towards a mode named "0".
state_read() {
	set -- $(cat "$STATE" 2>/dev/null)
	LAST_SWITCH=${1:-0}
	CANDIDATE=${2:--}
	CONFIRMED=${3:-0}
	[ "$CANDIDATE" = - ] && CANDIDATE=
	return 0
}

state_write() {
	echo "$LAST_SWITCH ${CANDIDATE:--} $CONFIRMED" >"$STATE" 2>/dev/null
}

# Two delays stand between a reading and the filter actually moving, and both
# exist because of a real oscillation seen on hardware: the picture hunted
# between colour and greyscale every time the light changed.
#
# THE CAUSE IS FEEDBACK, and it is specific to the gain source. AeAGain is the
# ISP's OWN exposure gain, so switching the ISP to night tuning changes the very
# number the decision was made from - and on a camera with the IR-cut fitted,
# moving the filter out of the light path changes how much light reaches the
# sensor outright, which moves the gain further still. A dead band between the
# two thresholds cannot help: the value does not creep across the boundary, it
# jumps clean over it. A photoresistor does not have this problem because it
# measures the room, not the pipeline.
#
#   dn_settle   seconds after a switch during which readings are ignored. The
#               pipeline is still re-converging and nothing it reports means
#               anything yet.
#   dn_confirm  how many consecutive ticks must agree before switching. Kills
#               both the tail of the feedback transient and real but brief
#               changes - headlights, a light switched on next door.
#
# Unlike the thresholds these DO have defaults, and the difference is not
# arbitrary: a wrong threshold makes the camera act on nonsense, while a wrong
# settle or confirm can only ever make it slower to switch. A default that can
# only be too cautious is safe to ship; one that can be confidently wrong is not.
settle_seconds() {
	v=$(env_get dn_settle)
	echo "${v:-180}"
}

confirm_ticks() {
	v=$(env_get dn_confirm)
	echo "${v:-3}"
}

switch_to() {
	MODE=$1
	ircut
	illuminator
	isp
	LAST_SWITCH=$(date +%s)
	CANDIDATE=
	CONFIRMED=0
	state_write
}

# Decide from how dark it is. Two thresholds with a dead band between them, so a
# value sitting near the boundary cannot throw the filter back and forth - each
# crossing costs a solenoid pulse and a visible jump in the picture.
#
# The thresholds are MANDATORY, with no defaults, and that is a safety property
# rather than an omission. Their right values depend on the source, the lens, the
# housing and where the camera points; and a camera whose photoresistor is not
# fitted reads a steady near-zero - measured on one here, 4 to 35 units, which is
# 1 to 8 raw counts of 4096 and does not move when the room lights go out. Any
# built-in number would read that as broad daylight or pitch darkness depending on
# its sense, and act on it. A first attempt with invented defaults did exactly
# that and drove the camera to night at noon.
auto() {
	value=$(darkness)
	case "$value" in
	''|*[!0-9]*)
		die "no usable reading from the '$(darkness_source)' source"
		;;
	esac

	night_above=$(env_get dn_night_above)
	day_below=$(env_get dn_day_below)
	if [ -z "$night_above" ] || [ -z "$day_below" ]; then
		die "auto needs thresholds: set dn_night_above and dn_day_below with
       fw_setenv, after reading the level with '$(basename "$0") light' in
       daylight and in the dark. Higher means darker. There are deliberately
       no defaults - see the comment above this function."
	fi

	state_read
	now=$(current_mode)

	if [ "$value" -gt "$night_above" ]; then
		want=night
	elif [ "$value" -lt "$day_below" ]; then
		want=day
	else
		want=$now		# in the dead band: leave it where it is
	fi

	# Already there: forget any lean that had started to build up, so a brief
	# excursion does not leave a half-finished count behind to be completed by
	# an unrelated one an hour later.
	if [ "$want" = "$now" ]; then
		if [ -n "$CANDIDATE" ]; then
			CANDIDATE=
			CONFIRMED=0
			state_write
		fi
		return 0
	fi

	settle=$(settle_seconds)
	elapsed=$(( $(date +%s) - LAST_SWITCH ))
	if [ "$LAST_SWITCH" -gt 0 ] && [ "$elapsed" -lt "$settle" ]; then
		[ -n "$VERBOSE" ] && echo "daynight: settling, ${elapsed}s of ${settle}s"
		return 0
	fi

	if [ "$CANDIDATE" = "$want" ]; then
		CONFIRMED=$((CONFIRMED + 1))
	else
		CANDIDATE=$want
		CONFIRMED=1
	fi

	confirm=$(confirm_ticks)
	if [ "$CONFIRMED" -lt "$confirm" ]; then
		state_write
		[ -n "$VERBOSE" ] && echo "daynight: darkness $value leans $want ($CONFIRMED/$confirm)"
		return 0
	fi

	switch_to "$want"
	echo "daynight: darkness $value -> $want"
}

current_mode() {
	if [ -r "$ISP_DAYNIGHT" ] && [ "$(cat "$ISP_DAYNIGHT")" = 1 ]; then
		echo night
	else
		echo day
	fi
}

status() {
	if [ -r "$ISP_DAYNIGHT" ]; then
		printf 'mode      : %s\n' "$(current_mode)"
	else
		printf 'mode      : unknown (no %s)\n' "$ISP_DAYNIGHT"
	fi
	printf 'source    : %s\n' "$(darkness_source)"
	printf 'darkness  : %s\n' "$(darkness || echo unavailable)"
	printf 'night above: %s\n' "$(env_get dn_night_above || echo UNSET)"
	printf 'day below : %s\n' "$(env_get dn_day_below || echo UNSET)"
	printf 'settle    : %ss\n' "$(settle_seconds)"
	printf 'confirm   : %s ticks\n' "$(confirm_ticks)"
	state_read
	if [ "$LAST_SWITCH" -gt 0 ]; then
		printf 'last switch: %ss ago\n' "$(( $(date +%s) - LAST_SWITCH ))"
	else
		printf 'last switch: never since boot\n'
	fi
	[ -n "$CANDIDATE" ] && printf 'leaning   : %s (%s ticks)\n' "$CANDIDATE" "$CONFIRMED"
	printf 'ircut pins: %s\n' "$(env_get gpio_ircut || echo unset)"
	printf 'ir850 pin : %s\n' "$(env_get gpio_ir850 || echo unset)"
}

case "$1" in
day|night)
	# Through switch_to, not straight at the hardware: it records the time, so
	# a switch made by hand gets the same settle window as any other and the
	# next tick does not immediately argue with it.
	state_read
	switch_to "$1"
	;;
auto)
	# Run by a person, so say what is being waited for - a silent "nothing
	# happened" is the wrong answer to someone debugging why it did not switch.
	VERBOSE=1
	auto
	;;
cron)
	# What crond calls every minute. It differs from "auto" in one way: on a
	# camera whose thresholds are not set it does nothing and says nothing,
	# where "auto" prints the calibration instructions and fails. Both
	# behaviours are wanted, by different callers - a person running this by
	# hand needs to be told what is missing, and a timer must not write that
	# same line to the log 1440 times a day. So the decision to stay quiet is
	# made here, by the caller that wants quiet, and never inside auto.
	[ -n "$(env_get dn_night_above)" ] && [ -n "$(env_get dn_day_below)" ] || exit 0
	auto
	;;
light|adc)		# adc: the older name, kept working
	darkness || die "no reading from the '$(darkness_source)' source"
	;;
status)
	status
	;;
*)
	echo "usage: $(basename "$0") day|night|auto|cron|light|status" >&2
	exit 2
	;;
esac
