#!/bin/sh

KMOD_PATH=/lib/modules/$(uname -r)/ingenic

# The environment is authoritative, ipcinfo is the fallback - the reverse of
# what the t20/t31/t40 scripts do. Two reasons. ipcinfo reports the SoC family
# from silicon, and a T41 announces the same generation as a T40 in
# 0x1300002C, so on some parts it answers "t40" - successfully, which means an
# "ipcinfo -f || fw_printenv -n soc" fallback never fires. And an explicit
# setting made by whoever installed the firmware should win over a guess.
# ingenic-osdrv-t30 already reads the environment directly.
SOC=$(fw_printenv -n soc 2>/dev/null)
[ -z "$SOC" ] && SOC=$(ipcinfo -f)
vendor=$(ipcinfo -v)

if [ ! -f /usr/sbin/sensor_cli ]; then
	ln -s /usr/sbin/extutils /usr/sbin/sensor_cli
fi

echo 1 >/proc/sys/vm/overcommit_memory

log_vendor() {
	logger -s -p daemon.info -t ${vendor} "$1"
}

check_return() {
	if [ $? -ne 0 ]; then
		echo err: $1
		echo exit
		exit
	fi
}

lsmod | grep "sinfo" >/dev/null
if [ $? -ne 0 ]; then
	modprobe sinfo
	check_return "insmod sinfo"
fi

if fw_printenv -n sensor >/dev/null 2>&1; then
	export SENSOR=$(fw_printenv -n sensor)
	log_vendor "Get data from environment and set SENSOR as ${SENSOR}"
else
	echo 1 >/proc/jz/sinfo/info
	check_return "start sinfo"
	SENSOR_INFO=$(cat /proc/jz/sinfo/info)
	check_return "get sensor type"
	SENSOR=${SENSOR_INFO#*:}
	if [ "sensor not found" = "$SENSOR" ]; then
		# sinfo cannot name this one. Its table stops at gc4663 for
		# GalaxyCore and has no gc5603 at all, and its clock names are the
		# older cgu_cim/div_cim rather than T41's, so an untouched camera
		# lands here every time. Left as it was, SENSOR stays empty and the
		# modprobe below asks for "sensor__t41", which does not exist: the
		# camera comes up with no image and nothing says why.
		#
		# Fall back to the sensor this image was built for. That is not a
		# guess - the build ships exactly one sensor driver and one ISP
		# tuning file, so it is the only sensor this image could drive.
		# Nothing is written to the environment: the value comes from the
		# image, so it is the same on every boot without persisting anything.
		SENSOR="@SNS_MODEL@"
		export SENSOR
		log_vendor "sinfo found no sensor, using the built-in default ${SENSOR}"
	else
		export SENSOR
		log_vendor "Get data from sinfo and set SENSOR as ${SENSOR}"
		fw_setenv sensor $SENSOR && log_vendor "Write detected ${SENSOR} to U-Boot ENV"
	fi
fi

# gc5603 wants a true 27 MHz MCLK, which on T41 comes from VPLL (1080/40).
# AVPU is clocked from sclka here rather than the vpll/654 MHz the T40 script
# uses; these are the values the vendor firmware for this board runs with.
case ${SENSOR} in
"gc5603")
	AVPU_PARAM="clk_name=sclka avpu_clk=550000000"
	ISP_PARAM="direct_mode=0"
	# The sensor reset is on PA18 on this board. majestic has no setting for
	# it and passes -1, so the driver takes it as a module parameter instead.
	SENSOR_PARAM="reset_gpio=18"
	;;
*)
	AVPU_PARAM="clk_name=sclka avpu_clk=550000000"
	ISP_PARAM="direct_mode=0"
	SENSOR_PARAM=""
	;;
esac

# Image orientation lives in the sensor on T41: its libimp exports no
# IMP_ISP_Tuning_SetISPHflip/Vflip, so majestic's mirror and flip settings have
# nothing to drive. Take it from the environment instead.
#   0 none, 1 mirror, 2 flip, 3 mirror+flip (180 degrees)
SENSOR_FLIP=$(fw_printenv -n sensor_flip 2>/dev/null)
if [ -n "$SENSOR_FLIP" ]; then
	SENSOR_PARAM="$SENSOR_PARAM shvflip=$SENSOR_FLIP"
fi

echo --------------------
echo "SOC: ${SOC}"
echo "AVPU_PARAM: ${AVPU_PARAM}"
echo "ISP_PARAM: ${ISP_PARAM}"
echo "SENSOR: ${SENSOR}"
echo "SENSOR_PARAM: ${SENSOR_PARAM}"
echo --------------------

lsmod | grep "avpu" >/dev/null
if [ $? -ne 0 ]; then
	modprobe avpu ${AVPU_PARAM}
	check_return "insmod avpu"
fi

lsmod | grep "tx_isp" >/dev/null
if [ $? -ne 0 ]; then
	modprobe tx-isp-${SOC} ${ISP_PARAM}
	check_return "insmod isp drv"
fi

lsmod | grep ${SENSOR} >/dev/null
if [ $? -ne 0 ]; then
	modprobe sensor_${SENSOR}_${SOC} ${SENSOR_PARAM}
	check_return "insmod sensor drv"
fi

lsmod | grep "audio" >/dev/null
if [ $? -ne 0 ]; then
	# No spk_gpio here, unlike the t20/t31 scripts. The vendor's audio.ko took
	# the speaker amplifier's enable pin as a module parameter; the one built
	# from openingenic for T41 does not declare it at all - its parameters are
	# aic_enable, dmic_enable, internal_codec, excodec_*, samplerate and
	# mic_mono_channel - so passing spk_gpio and spk_level only looked like
	# configuring the speaker while being silently ignored.
	#
	# The amplifier is driven from userspace instead, through majestic's
	# .audio.speakerPin, which is claimed further down with the other pins. On
	# the DML16-Z533 variant that has a speaker fitted the pin is 63 (PB31),
	# active-high, per the vendor audio.ko's own defaults.
	modprobe audio
	check_return "insmod audio"
fi

lsmod | grep "gpio" >/dev/null
if [ $? -ne 0 ]; then
	modprobe gpio
	check_return "insmod gpio"
fi

# majestic reads the ambient-light ADC from /dev/jz_adc_aux_0 - the name the
# older vendor driver used - while the driver in this kernel registers itself as
# ingenic_adc_aux_%d. So "adcReadout: true" fails with
#
#   Cannot open adc path: /dev/jz_adc_aux_0
#
# on every camera, including the ones that do have a photoresistor fitted, which
# is part of why automatic day/night looked impossible here. A symlink is enough,
# and is preferable to renaming the device: the driver's name matches the rest of
# the tree, and anything already using it keeps working.
# Which AUX channel the light sensor is actually on. A board fact, so it comes
# from the environment, and it is a CHANNEL index rather than a GPIO number -
# hence adc_channel and not adc_pin, which would invite putting a pin number
# there.
#
# Pointing the compatibility symlink at it, rather than teaching each reader
# about the setting, is what makes one variable enough: majestic opens the old
# name and nothing else, so a sensor on any channel but 0 leaves its adcReadout
# dead as well. Aim the link and both it and nightsync follow.
ADC_CHANNEL=$(fw_printenv -n adc_channel 2>/dev/null)
[ -n "$ADC_CHANNEL" ] || ADC_CHANNEL=0

if [ -e /dev/ingenic_adc_aux_$ADC_CHANNEL ]; then
	[ -e /dev/jz_adc_aux_0 ] || ln -sf /dev/ingenic_adc_aux_$ADC_CHANNEL /dev/jz_adc_aux_0
else
	# Say so. Left quiet, a channel number with a typo in it produces no link,
	# whoever reads the ADC falls back to channel 0, and the camera reports a
	# sensor that is not the one anybody configured.
	log_vendor "adc_channel=${ADC_CHANNEL} does not exist, no ADC device link made"
fi

# Polarity, for a photoresistor wired the other way round. The driver returns
# (invert - reading) clamped at 0, so this is a ceiling to subtract from and
# wants a value slightly above full scale - 20000 for a 14-bit-ish range - not
# a boolean. Zero, and the default, leave it alone.
#
# The driver is built into the kernel here, so there is no modprobe line to put
# this on and a value written by hand does not survive a reboot. Writing it at
# every start is what makes it a setting rather than a fiddle.
ADC_INVERT=$(fw_printenv -n adc_invert 2>/dev/null)
if [ -n "$ADC_INVERT" ] && [ -w /sys/module/ingenic_adc_aux/parameters/invert ]; then
	echo "$ADC_INVERT" >/sys/module/ingenic_adc_aux/parameters/invert
	log_vendor "ADC invert ceiling set to ${ADC_INVERT}"
fi

# The GPIO claims come from majestic's configuration, so there is nothing to
# claim before majestic is installed. Without this guard cli prints
# "Failed to open input file /etc/majestic.yaml" once per GPIO at every boot.
if [ ! -z "$(lsmod | grep "gpio")" ] && [ -f /etc/majestic.yaml ]; then
	# irSensorPin is the old name for the light sensor and this majestic calls
	# it lightSensorPin - its key table has no irSensorPin at all. Both are
	# listed rather than swapped: a key that is not in the configuration simply
	# yields nothing here, so carrying the old one costs a lookup and keeps an
	# older streamer working.
	GPIOS=".nightMode.irCutPin1 .nightMode.irCutPin2 .nightMode.irSensorPin .nightMode.lightSensorPin .nightMode.backlightPin .audio.speakerPin"
	for GPIO in $(echo ${GPIOS})
	do
		G=$(cli -g ${GPIO})
		[ ! -z "${G}" ] && echo ${G} > /proc/gpio_claim/gpio
	done
fi
