+/* Not every T-series libimp exports the whole tuning API. T41's has no
+ * GetContrast, no GetSensorFPS and neither flip call, and musl resolves a
+ * shared object's symbols when it is loaded rather than when they are first
+ * called - so one missing symbol makes dlopen() fail and takes every command
+ * in the plugin with it, including the ones that would have worked.
+ *
+ * Weak declarations make an absent symbol resolve to NULL instead, confining
+ * the loss to the one command that needs it. Every call site checks. */
+#define WEAK __attribute__((weak))
+WEAK int IMP_ISP_Tuning_GetContrast(unsigned char *pcontrast);
+WEAK int IMP_ISP_Tuning_GetSensorFPS(uint32_t *pfps_num, uint32_t *pfps_den);
+WEAK int IMP_ISP_Tuning_SetISPHflip(IMPISPTuningOpsMode mode);
+WEAK int IMP_ISP_Tuning_SetISPVflip(IMPISPTuningOpsMode mode);
+WEAK int IMP_ISP_Tuning_SetISPRunningMode(IMPISPRunningMode mode);
+WEAK int IMP_ISP_Tuning_SetBrightness(unsigned char bright);
+WEAK int IMP_ISP_Tuning_GetBrightness(unsigned char *pbright);
+WEAK int IMP_ISP_Tuning_SetContrast(unsigned char contrast);
+WEAK int IMP_ISP_Tuning_SetSaturation(unsigned char sat);
+WEAK int IMP_ISP_Tuning_GetSaturation(unsigned char *psat);
+WEAK int IMP_ISP_Tuning_SetSharpness(unsigned char sharp);
+WEAK int IMP_ISP_Tuning_GetSharpness(unsigned char *psharp);
+
+/* Some of these knobs are reachable through the ISP driver instead, as module
+ * parameters, and on T41 that is the only route that works: the library either
+ * does not export the call or faults inside it. The driver is named after its
+ * SoC (tx-isp-t41 and so on), so the module directory is found rather than
+ * assumed, and a SoC whose driver has no such parameter falls through to the
+ * library exactly as before. */
+static int module_param_path(const char *prefix, const char *name,
+			     char *out, size_t len) {
+	DIR *d = opendir("/sys/module");
+	if (!d) {
+		return 0;
+	}
+
+	size_t plen = strlen(prefix);
+	struct dirent *e;
+	int found = 0;
+	while (!found && (e = readdir(d))) {
+		/* Both spellings: module names use underscores, but the source they
+		 * are built from is often hyphenated and either can turn up. */
+		if (strncmp(e->d_name, prefix, plen)) {
+			continue;
+		}
+
+		snprintf(out, len, "/sys/module/%s/parameters/%s", e->d_name, name);
+		found = access(out, F_OK) == 0;
+	}
+
+	closedir(d);
+	return found;
+}
+
+static int isp_param_path(const char *name, char *out, size_t len) {
+	return module_param_path("tx_isp", name, out, len) ||
+	       module_param_path("tx-isp", name, out, len);
+}
+
+static int isp_param_write(const char *name, int value) {
+	char path[128], buf[16];
+	if (!isp_param_path(name, path, sizeof(path))) {
+		return 0;
+	}
+
+	int fd = open(path, O_WRONLY);
+	if (fd < 0) {
+		return 0;
+	}
+
+	int len = snprintf(buf, sizeof(buf), "%d", value);
+	int ok = write(fd, buf, len) == len;
+	close(fd);
+	return ok;
+}
+
+static int isp_param_read(const char *name, int *value) {
+	char path[128], buf[16];
+	if (!isp_param_path(name, path, sizeof(path))) {
+		return 0;
+	}
+
+	int fd = open(path, O_RDONLY);
+	if (fd < 0) {
+		return 0;
+	}
+
+	int n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0) {
+		return 0;
+	}
+
+	buf[n] = 0;
+	*value = atoi(buf);
+	return 1;
+}
+
 static void set_blackwhite(const char *value) {
 	bool index = strlen(value) ? atoi(value) : false;
+	/* On T41 IMP_ISP_Tuning_SetISPRunningMode is exported but faults inside
