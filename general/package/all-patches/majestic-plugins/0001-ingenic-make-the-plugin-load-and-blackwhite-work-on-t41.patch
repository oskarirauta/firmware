+	 * only route. It also matters beyond this command: majestic has no ingenic
+	 * implementation of the grey conversion ("Not implemented for platform
+	 * ingenic"), so this is what makes the picture actually turn grey. */
+	if (isp_param_write("daynight", index)) {
+		RETURN("Set blackwhite: %d", index);
+	}
+
+	if (!IMP_ISP_Tuning_SetISPRunningMode) {
+		RETURN("Set blackwhite unsupported on this SoC");
+	}
+
 	if (IMP_ISP_Tuning_SetISPRunningMode(index)) {
 		RETURN("IMP_ISP_Tuning_SetISPRunningMode failed");
 	}
