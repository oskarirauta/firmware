From c53bafd18a935337df5246a8d4b8f106273290be Mon Sep 17 00:00:00 2001
From: Oskari Rauta <oskari.rauta@gmail.com>
Date: Tue, 28 Jul 2026 13:40:44 +0000
Subject: [PATCH 105/111] mtd: ingenic_sfc_v2: make the NOR erase block size
 selectable

Every chip in this driver's table hardcodes a 32 KiB erase block, and
flash->mtd.erasesize is taken straight from it. That is a poor fit for a
jffs2 overlay: 64 KiB is the usual erase block for NOR, and an erase size
that disagrees with the jffs2 on the partition is not reported as an
error. jffs2 mis-manages the blocks instead - writes silently fail to
stick, old nodes stay alive, and settings appear to "resurrect" after a
reflash. It presents as a build, flash or upgrade bug and is none of
those.

The 64 KiB block erase command (NOR_ERASE_WRITE_ENABLE_64K) is already
fully implemented in this driver and sfc_do_erase() already has the
0x10000 case, so only the size needs to become selectable. The choice
defaults to ERASE_SIZE_32K, so every board that does not ask for 64K
compiles the same 32 * 1024 it did before and the substitution does not
even shift a line number.

Diagnosis, symptoms and the confirming board are documented in detail by
Oskari Rauta from the T41NQ bring-up; the same reasoning applies to any
board using ingenic_sfc_v2 with a 64K jffs2.
---
 drivers/mtd/devices/ingenic_sfc_v2/Kconfig    | 21 +++++
 drivers/mtd/devices/ingenic_sfc_v2/spinor.h   | 92 +++++++++----------
 .../mtd/devices/ingenic_sfc_v2/spinor_cmd.h   |  6 ++
 3 files changed, 73 insertions(+), 46 deletions(-)

diff --git a/drivers/mtd/devices/ingenic_sfc_v2/Kconfig b/drivers/mtd/devices/ingenic_sfc_v2/Kconfig
index fc7702f9..f088c073 100644
--- a/drivers/mtd/devices/ingenic_sfc_v2/Kconfig
+++ b/drivers/mtd/devices/ingenic_sfc_v2/Kconfig
@@ -40,5 +40,26 @@ config SPI_QUAD_MODE
 	  Say Y Here to enable spi QUAD MODE
 endchoice
 
+choice
+	prompt "Erase block size"
+	default ERASE_SIZE_32K
+	help
+	  Select nor flash erase block size.
+
+	  This must match the erase block size the jffs2 on the writable
+	  partition was created with. A mismatch is not reported as an error:
+	  jffs2 mis-manages the blocks, writes silently fail to stick and old
+	  nodes stay alive. 64K is the usual choice for NOR.
+
+config ERASE_SIZE_32K
+	bool "sfc-nor 32k erase block"
+	depends on MTD_INGENIC_SFC_V2_NORFLASH
+
+config ERASE_SIZE_64K
+	bool "sfc-nor 64k erase block"
+	depends on MTD_INGENIC_SFC_V2_NORFLASH
+
+endchoice
+
 endif
 
