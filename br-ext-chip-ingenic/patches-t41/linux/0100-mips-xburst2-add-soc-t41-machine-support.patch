+#define FASTBOOT_RESUME_CODE1_ADDR	RTC_MEMORY_START
+//RESUME code end addr
+#define FASTBOOT_RESUME_CODE2_ADDR	(FASTBOOT_RESUME_CODE1_ADDR + FASTBOOT_RESUME_CODE1_LEN)
