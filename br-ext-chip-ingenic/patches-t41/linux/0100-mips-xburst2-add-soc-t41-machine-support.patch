+static void rtc_ram_write_enable(void)
+{
+	unsigned int tmp;
+
+	/* write RTC RAM enable */
+	tmp = rtc_read_reg(0xb0003048);
+	tmp &= ~(1 << 23);
+	tmp &= ~(1 << 22);
+	tmp |= (1 << 21);
+	tmp |= (1 << 20);
+	rtc_write_reg(0xb0003048, tmp);
+
+}
+
+static void rtc_ram_write_disable(void)
+{
+	unsigned int tmp;
+	/*exit write RTC RAM enable */
+	tmp = rtc_read_reg(0xb0003048);
+	tmp |= (1 << 22);
+	rtc_write_reg(0xb0003048, tmp);
+
+}
