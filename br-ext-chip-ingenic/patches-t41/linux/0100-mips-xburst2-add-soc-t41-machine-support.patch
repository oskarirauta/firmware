+static noinline void fastboot_cpu_resume(void)
+{
+
+
+	*(volatile unsigned int *)0xb2200f00 = 0xbfc00000; /* RESET entry = 0xbfc00000 ,reset value */
+
+	__asm__ volatile(
+		".set push	\n\t"
+		".set mips32r2	\n\t"
+		"jr.hb %0	\n\t"
+		"sync		\n\t"
+		"nop		\n\t"
+		".set pop 	\n\t"
+		:
+		: "r" (restore_goto)
+		:
+		);
+}
