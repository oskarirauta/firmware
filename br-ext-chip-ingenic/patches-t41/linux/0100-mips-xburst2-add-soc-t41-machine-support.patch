diff --git a/arch/mips/xburst2/core/include/core_base.h b/arch/mips/xburst2/core/include/core_base.h
index 993db3a3..e9d733f3 100644
--- a/arch/mips/xburst2/core/include/core_base.h
+++ b/arch/mips/xburst2/core/include/core_base.h
@@ -2,7 +2,16 @@
 #define __CORE_BASE_H__
 
 /* for xburst2 INTC base 0x12300000*/
+/*
+ * T41 places the interrupt controller at 0x10001000 and declares it in
+ * soc-t41/include/soc/base.h. soc-t41/pm/pm_fastboot.c includes both that
+ * header and this one, so the generic XBurst2 value must not be defined for
+ * T41 or the two collide. SOC_T40/SOC_T41/SOC_X2000_V12 are a Kconfig choice,
+ * so with CONFIG_SOC_T41 unset this file is unchanged for every other SoC.
+ */
+#ifndef CONFIG_SOC_T41
 #define	INTC_IOBASE	0x12300000
+#endif
 /* CCU IO base address */
 //#define CCU_IO_BASE		(read_c0_config7 & 0xffff0000)
 #define CCU_IO_BASE			0x12200000
