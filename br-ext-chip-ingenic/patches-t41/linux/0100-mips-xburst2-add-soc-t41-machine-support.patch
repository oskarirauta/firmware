+	mtc0	k1,CP0_CONFIG3
+	lw	k1,84(k0)
+	mtc0	k1,CP0_CONFIG4
+	lw	k1,88(k0)
+	mtc0	k1,CP0_CONFIG5
+	lw	k1,92(k0)
