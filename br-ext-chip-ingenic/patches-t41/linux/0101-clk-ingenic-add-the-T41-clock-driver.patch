diff --git a/drivers/clk/ingenic/clk.h b/drivers/clk/ingenic/clk.h
index 1da80da5..2af39f7b 100644
--- a/drivers/clk/ingenic/clk.h
+++ b/drivers/clk/ingenic/clk.h
@@ -433,6 +433,39 @@ struct ingenic_clk_reg_dump {
 	u32	value;
 };
 
+#ifdef CONFIG_SOC_T41
+/*
+ * T41 cannot restore a clock divider register by writing the saved word back:
+ * each CDR register has a change-enable bit that must be set for the write to
+ * take, and a busy bit to poll. Its clock driver therefore describes every
+ * register it wants preserved across suspend with REG_SLEEP() instead of a
+ * bare offset. Only SOC_T41 builds see any of this.
+ */
+#define REG_SLEEP(o, c, b, f)	\
+{	\
+	.offset = o,	\
+	.ce = c,	\
+	.busy = b,	\
+	.flags = f,	\
+}
+
+/**
+ * struct ingenic_clk_reg_sleep: register dump of clock controller registers.
+ * @offset: clock register offset from the controller base address.
+ * @value: the value to be register at offset.
+ * @ce: bit number of the change-enable bit, 0 if the register has none.
+ * @busy: bit number of the busy bit, 0 if the register has none.
+ * @flags: per-register flags.
+ */
+struct ingenic_clk_reg_sleep {
+	u32	offset;
+	u32	value;
+	u32	ce;
+	u32	busy;
+	u32	flags;
+};
+#endif /* CONFIG_SOC_T41 */
+
 /**
  * struct ingenic_pll_clock: information about pll clock
  * @id: platform specific id of the clock.
@@ -472,8 +505,13 @@ struct ingenic_pll_clock {
