--- a/drivers/clk/ingenic/Makefile
+++ b/drivers/clk/ingenic/Makefile
@@ -5,3 +5,4 @@ obj-$(CONFIG_SOC_X2000_V12)	+= clk-x2000-v12.o
 obj-$(CONFIG_SOC_T40)	+= clk-t40.o
 
 
+obj-$(CONFIG_SOC_T41)	+= clk-t41.o
diff --git a/drivers/clk/ingenic/clk-pll.c b/drivers/clk/ingenic/clk-pll.c
index 15ce5fde..66488d4e 100644
--- a/drivers/clk/ingenic/clk-pll.c
+++ b/drivers/clk/ingenic/clk-pll.c
@@ -57,7 +57,16 @@ static unsigned long ingenic_t40_pll_recalc_rate(struct clk_hw *hw, unsigned lon
 	n = (val >> pll->hwdesc->n_sft) & GENMASK(pll->hwdesc->n_width - 1, 0);
 	m = (val >> pll->hwdesc->m_sft) & GENMASK(pll->hwdesc->m_width - 1, 0);
 
+	/*
+	 * T41 encodes the PLL dividers as N-1 and od0 as a power of two, so it
+	 * needs the full form. The other XBurst2 SoCs in this tree keep the
+	 * plain form they have always used.
+	 */
+#ifdef CONFIG_SOC_T41
+	rate = ((parent_rate / 1000000 ) * (m + 1) * 2) / ((n + 1) * (1 << od0) * (od1 + 1));
+#else
 	rate = (parent_rate / 1000000 ) * m / n / od0 / od1;
+#endif
 
 	//printk("od0: %d, od1: %d, m: %d, n: %d, tmp: %x, tmp2: %x, rate:%ld\n", od0, od1, m, n, tmp, tmp2, rate);
     rate = rate*1000000;
@@ -83,6 +92,9 @@ static int ingenic_t40_pll_set_rate(struct clk_hw *hw, unsigned long drate, unsi
 	struct ingenic_clk_pll *pll = to_clk_pll(hw);
 
 	unsigned int m, n, od1, od0;
+#ifdef CONFIG_SOC_T41
+	unsigned int rg = 0;
+#endif
 	unsigned int val, i;
 
 	for (i = 0; i < pll->rate_count; i++) {
@@ -91,11 +103,18 @@ static int ingenic_t40_pll_set_rate(struct clk_hw *hw, unsigned long drate, unsi
 			n = pll->rate_table[i].n;
 			od1 = pll->rate_table[i].od1;
 			od0 = pll->rate_table[i].od0;
+#ifdef CONFIG_SOC_T41
+			rg = pll->rate_table[i].rg;
+#endif
 		}
 	}
 
 	writel(0, pll->con_reg);
-	val = (m << pll->hwdesc->m_sft) | (n << pll->hwdesc->n_sft) | (od1 << pll->hwdesc->od1_sft) | (od0 << pll->hwdesc->od0_sft) | 1;
+	val = (m << pll->hwdesc->m_sft) | (n << pll->hwdesc->n_sft) | (od1 << pll->hwdesc->od1_sft) | (od0 << pll->hwdesc->od0_sft)
+#ifdef CONFIG_SOC_T41
+		| (rg << pll->hwdesc->rg_sft)
+#endif
+		| 1;
 	writel(val, pll->con_reg);
 
 	wait_pll_stable(pll->con_reg, pll->hwdesc->on_bit);
diff --git a/drivers/clk/ingenic/clk-pll.h b/drivers/clk/ingenic/clk-pll.h
index 2b39a48a..a4d1d3f8 100644
--- a/drivers/clk/ingenic/clk-pll.h
+++ b/drivers/clk/ingenic/clk-pll.h
@@ -4,6 +4,46 @@
 
 extern const struct clk_ops ingenic_pll_ro_ops;
 
+/*
+ * T41's PLL differs from the other XBurst2 SoCs in this tree: its rate table
+ * carries an extra "rg" (charge-pump resistor) field, its register description
+ * needs the matching rg field position, and the vendor writes the od fields in
+ * the opposite order. SOC_T40, SOC_X2000_V12 and SOC_T41 are arms of one
+ * Kconfig choice, so exactly one of these branches is ever compiled and the
+ * non-T41 SoCs see this header exactly as they did before T41 was added.
+ */
+#ifdef CONFIG_SOC_T41
+
+#define PLL_RATE(_rate, _m, _n, _od0, _od1, _rg)	\
+{					\
+	.rate = _rate,			\
+	.m = _m,			\
+	.n = _n,			\
+	.od0 = _od0,			\
+	.od1 = _od1,			\
+	.rg = _rg,			\
+}
+
+#define PLL_DESC(_regoff, _m, _m_w, _n, _n_w, _od0, _od0_w, _od1, _od1_w, _rg, _rg_w, _on, _en, _bs)	\
+{				\
+	.regoff = _regoff,	\
+	.m_sft = _m,		\
+	.m_width = _m_w,	\
+	.n_sft = _n,		\
+	.n_width = _n_w,	\
+	.od0_sft = _od0,		\
+	.od0_width = _od0_w,	\
+	.od1_sft = _od1,		\
+	.od1_width = _od1_w,	\
+	.rg_sft = _rg,		\
+	.rg_width = _rg_w,	\
+	.on_bit = _on,		\
+	.en_bit =  _en,		\
+	.bs_bit = _bs,	\
+}
+
+#else /* !CONFIG_SOC_T41 */
+
 #define PLL_RATE(_rate, _m, _n, _od1, _od0)	\
 {					\
 	.rate = _rate,			\
@@ -13,14 +53,6 @@ extern const struct clk_ops ingenic_pll_ro_ops;
 	.od0 = _od0,			\
 }
 
-struct ingenic_pll_rate_table {
-	unsigned int rate;
-	unsigned int m;
-	unsigned int n;
-	unsigned int od1;
-	unsigned int od0;
-};
-
 #define PLL_DESC(_regoff, _m, _m_w, _n, _n_w, _od1, _od1_w, _od0, _od0_w, _on, _en, _bs)	\
 {				\
 	.regoff = _regoff,	\
@@ -37,6 +69,19 @@ struct ingenic_pll_rate_table {
 	.bs_bit = _bs,	\
 }
 
+#endif /* CONFIG_SOC_T41 */
+
+struct ingenic_pll_rate_table {
+	unsigned int rate;
+	unsigned int m;
+	unsigned int n;
+	unsigned int od1;
+	unsigned int od0;
+#ifdef CONFIG_SOC_T41
+	unsigned int rg;
+#endif
+};
+
 struct ingenic_pll_hwdesc {
 	u32 regoff;
 	u8 m_sft;
@@ -47,6 +92,10 @@ struct ingenic_pll_hwdesc {
 	u8 od1_width;
 	u8 od0_sft;
 	u8 od0_width;
+#ifdef CONFIG_SOC_T41
+	u8 rg_sft;
+	u8 rg_width;
+#endif
 	u8 on_bit;
 	u8 en_bit;
 	s8 bs_bit;
