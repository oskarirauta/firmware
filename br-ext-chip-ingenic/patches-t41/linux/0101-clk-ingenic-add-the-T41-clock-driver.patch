 	struct ingenic_clk_reg_dump *rdump;
 	unsigned int rd_num;
+#endif
 };
 
 struct ingenic_cmu_info {
@@ -569,6 +607,18 @@ extern struct ingenic_clk_reg_dump *ingenic_clk_alloc_reg_dump(
 			const unsigned long *rdump,
