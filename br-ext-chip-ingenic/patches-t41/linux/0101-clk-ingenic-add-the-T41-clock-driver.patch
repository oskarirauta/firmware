diff --git a/drivers/clk/ingenic/clk.c b/drivers/clk/ingenic/clk.c
index e5226202..0e57d724 100644
--- a/drivers/clk/ingenic/clk.c
+++ b/drivers/clk/ingenic/clk.c
@@ -456,6 +456,88 @@ unsigned long _get_rate(const char *clk_name)
 	return clk_get_rate(clk);
 }
 
+/*
+ * T41 restores clock registers through a change-enable bit rather than by
+ * writing the saved word straight back, so it needs its own save/restore pair
+ * and a sleep_init that takes a descriptor table instead of a list of bare
+ * offsets. SOC_T41 is one arm of a Kconfig choice, so every other SoC compiles
+ * exactly the code it did before T41 existed.
+ */
+#ifdef CONFIG_SOC_T41
+
+#ifdef CONFIG_PM_SLEEP
+void ingenic_clk_save_sleep(void __iomem *base,
+				    struct ingenic_clk_reg_sleep *rd,
+				    unsigned int num_regs)
+{
+	for (; num_regs > 0; --num_regs, ++rd)
+		rd->value = readl(base + rd->offset);
+}
+
+void ingenic_clk_restore_sleep(void __iomem *base,
+				      struct ingenic_clk_reg_sleep *rd,
+				      unsigned int num_regs)
+{
+	for (; num_regs > 0; --num_regs, ++rd) {
+		if (!rd->ce && !rd->busy)
+			writel(rd->value, base + rd->offset);
+		else
+			writel(rd->value | 1 << rd->ce, base + rd->offset);
+	}
+}
+
+static int ingenic_clk_suspend(void)
+{
+	struct ingenic_clock_reg_cache *reg_cache;
+
+	list_for_each_entry(reg_cache, &clock_reg_cache_list, node)
+		ingenic_clk_save_sleep(reg_cache->reg_base, reg_cache->reg_sleep,
+				reg_cache->nr_reg_sleep);
+	return 0;
+}
+
+static void ingenic_clk_resume(void)
+{
+	struct ingenic_clock_reg_cache *reg_cache;
+
+	list_for_each_entry(reg_cache, &clock_reg_cache_list, node)
+		ingenic_clk_restore_sleep(reg_cache->reg_base, reg_cache->reg_sleep,
+				reg_cache->nr_reg_sleep);
+}
+
+static struct syscore_ops ingenic_clk_syscore_ops = {
+	.suspend = ingenic_clk_suspend,
+	.resume = ingenic_clk_resume,
+};
+
+void __init ingenic_clk_sleep_init(void __iomem *reg_base,
+		struct ingenic_clk_reg_sleep *reg_sleep,
+		unsigned long nr_reg_sleep)
+{
+	struct ingenic_clock_reg_cache *reg_cache;
+
+	reg_cache = kzalloc(sizeof(struct ingenic_clock_reg_cache),
+			GFP_KERNEL);
+	if (!reg_cache)
+		panic("could not allocate register reg_cache.\n");
+
+	reg_cache->reg_sleep = reg_sleep;
+	reg_cache->nr_reg_sleep = nr_reg_sleep;
+
+	if (list_empty(&clock_reg_cache_list))
+		register_syscore_ops(&ingenic_clk_syscore_ops);
+
+	reg_cache->reg_base = reg_base;
+	list_add_tail(&reg_cache->node, &clock_reg_cache_list);
+}
+#else
+void __init ingenic_clk_sleep_init(void __iomem *reg_base,
+		struct ingenic_clk_reg_sleep *reg_sleep,
+		unsigned long nr_reg_sleep) {}
+#endif /* CONFIG_PM_SLEEP */
+
+#else /* !CONFIG_SOC_T41 */
+
 #ifdef CONFIG_PM_SLEEP
 static int ingenic_clk_suspend(void)
 {
@@ -510,3 +592,5 @@ static void ingenic_clk_sleep_init(void __iomem *reg_base,
 		unsigned long nr_rdump) {}
 #endif
 
+#endif /* CONFIG_SOC_T41 */
