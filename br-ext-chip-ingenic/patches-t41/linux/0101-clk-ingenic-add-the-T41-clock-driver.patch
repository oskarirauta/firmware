 drivers/clk/ingenic/Makefile            |   1 +
 drivers/clk/ingenic/clk-pll.c           |  21 +-
 drivers/clk/ingenic/clk-pll.h           |  65 +++-
 drivers/clk/ingenic/clk-t41.c           | 398 ++++++++++++++++++++++++
 drivers/clk/ingenic/clk.c               |  84 +++++
 drivers/clk/ingenic/clk.h               |  50 +++
 include/dt-bindings/clock/ingenic-t41.h | 139 +++++++++
 8 files changed, 756 insertions(+), 9 deletions(-)
 create mode 100644 drivers/clk/ingenic/clk-t41.c
 create mode 100644 include/dt-bindings/clock/ingenic-t41.h

diff --git a/drivers/clk/ingenic/Kconfig b/drivers/clk/ingenic/Kconfig
index 0fac4081..b104a1e1 100644
--- a/drivers/clk/ingenic/Kconfig
+++ b/drivers/clk/ingenic/Kconfig
