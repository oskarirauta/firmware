# Architecture
BR2_mipsel=y
BR2_mips_xburst=y
# BR2_MIPS_SOFT_FLOAT is not set
BR2_MIPS_FP32_MODE_64=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/$(OPENIPC_TOOLCHAIN).tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="mipsel-openipc-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_4=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel
# T41 rides the ingenic-t40 kernel tarball and the ingenic-t40 toolchain, both
# selected from SOC_FAMILY. T41 support arrives as the patch series in
# patches-t41/linux, which is why BR2_GLOBAL_PATCH_DIR is overridden below to
# list that directory in addition to the shared one from general/openipc.fragment.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/$(OPENIPC_KERNEL).tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
# board/t41, not board/$(OPENIPC_SOC_FAMILY). SOC_FAMILY has to stay "t40"
# because it selects the kernel tarball and the toolchain release, and neither
# an ingenic-t41 branch nor a toolchain.ingenic-t41 exists to point it at. That
# is a packaging constraint, not a statement about the silicon, so the board
# files live under their own name and the two are deliberately decoupled.
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/t41/t41nq.generic.config"
BR2_LINUX_KERNEL_LZMA=y
# $(EXTERNAL_VENDOR) cannot be used here: it is defined in general/external.mk,
# which buildroot includes only after package/pkg-generic.mk has already checked
# that every directory named here exists. $(BR2_EXTERNAL) is set early enough.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL)/package/all-patches $(BR2_EXTERNAL)/../br-ext-chip-ingenic/patches-t41"

# U-Boot
# OpenIPC has no working T41 bootloader, so the board ships its own. It is built
# here, by OpenIPC's own buildroot and toolchain, rather than being fetched
# prebuilt from anywhere else.
#
# The source is the stock upstream u-boot 2026.07 release tarball from denx.
# T41 needs it: the 2013-era vendor u-boot that OpenIPC's other Ingenic boards
# use has no XBurst2 T41 support at all. Ingenic T-series support arrives as the
# patch series in patches-t41/uboot/2026.07 - see the PROVENANCE.md there.
#
# -j1 because the SPL and the LZMA-compressed payload are stitched together by
# rules that race under parallel make; the failure is an occasional short image
# rather than an error, so it is not worth the seconds saved.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.07"
BR2_TARGET_UBOOT_USE_DEFCONFIG=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="isvp_t41nq_sfcnor"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(EXTERNAL_VENDOR)/board/t41/t41nq.uboot.config"
# Because this board builds its own bootloader it can also ship a full-chip
# image, so a blank camera needs one write instead of three. The layout lives
# next to the board's other configuration; the path is relative to the tree root
# because the top-level Makefile, which assembles the image, has no
# $(EXTERNAL_VENDOR) at the point it reads this.
BR2_OPENIPC_FLASHMAP="br-ext-chip-ingenic/board/t41/t41nq.flashmap"
BR2_TARGET_UBOOT_NEEDS_XXD=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-with-spl-lzma.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="-j1"

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="ingenic"
# t41, not t41nq: SOC_MODEL selects the driver directory in openipc/openingenic
# (isp/$(SOC), sensors/$(SOC)/...), builds the module names load_ingenic probes
# (tx-isp-${SOC}, sensor_${SENSOR}_${SOC}) and names the ISP tuning file
# $(SNS)-$(SOC_MODEL).bin. Every T41 SKU shares those drivers, and OpenIPC's other
# Ingenic boards likewise use one model per SoC generation (t31 covers many cameras).
# The camera-specific part stays in this defconfig's name and in t41nq.dts.
BR2_OPENIPC_SOC_MODEL="t41"
BR2_OPENIPC_SOC_FAMILY="t40"
BR2_OPENIPC_SNS_MODEL="gc5603"
BR2_OPENIPC_VARIANT="lite"
BR2_OPENIPC_FLASH_SIZE="16"

# Packages
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_INGENIC_OPENSDK=y
BR2_PACKAGE_INGENIC_OSDRV_T41=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_LIBEVENT_OPENIPC=y
BR2_PACKAGE_LIBOGG_OPENIPC=y
BR2_PACKAGE_LINUX_FIRMWARE_OPENIPC=y
BR2_PACKAGE_RTL8733BU_OPENIPC=y
# No majestic is published for t41; SOC_FAMILY="t40" makes this fetch
# majestic.t40.lite, which may or may not match the T41 IMP ABI. Unknown until
# it runs - if it does not, the ask upstream is a majestic.t41 build.
BR2_PACKAGE_MAJESTIC=y
BR2_PACKAGE_MAJESTIC_FONTS=y
BR2_PACKAGE_MAJESTIC_PLUGINS=y
BR2_PACKAGE_MAJESTIC_WEBUI=y
BR2_PACKAGE_MBEDTLS_OPENIPC=y
BR2_PACKAGE_OPUS_OPENIPC=y
BR2_PACKAGE_OPUS_OPENIPC_FIXED_POINT=y
BR2_PACKAGE_YAML_CLI=y
