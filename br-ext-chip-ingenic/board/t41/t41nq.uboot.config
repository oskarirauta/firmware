# U-Boot configuration for the T41NQ (GC5603, 16 MiB SPI NOR).
#
# Merged onto isvp_t41nq_sfcnor_defconfig by merge_config.sh. Everything the
# stock defconfig already gets right is deliberately absent here, so this file
# reads as the list of decisions this board actually makes.

# Where u-boot keeps its own environment. This has to agree with the "env"
# partition in the mtdparts line of the built-in environment, and with
# CONFIG_ENV_SECT_SIZE matching the chip's real 64 KiB erase block - a smaller
# value makes saveenv read-modify-write the wrong span.
CONFIG_ENV_OFFSET=0x50000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000

# The built-in default environment, added as board/ingenic/isvp-t41/isvp-t41nq.env
# by the patch series. This is what makes the image flash-and-go: a board whose
# environment sector is blank or corrupt still boots, which matters because
# there is then no Linux and so no fw_setenv to repair it with.
#
# ENV_USE_DEFAULT_ENV_TEXT_FILE rather than ENV_SOURCE_FILE, because the two are
# alternatives rather than variations: in include/env_default.h the generated
# default environment and the file are the two arms of one #if/#else. Taking
# this arm means the file IS the environment, with nothing behind it.
#
# The generated alternative would additionally carry bootdelay, loadaddr,
# mtdids and usb_ignorelist - none of which this board uses, and mtdids and
# usb_ignorelist would ship as empty strings. Dropping bootdelay and baudrate
# from the environment is safe: common/autoboot.c and common/board_f.c fall back
# to CONFIG_BOOTDELAY and CONFIG_BAUDRATE when the variables are absent.
#
# Note the two arms process the file differently. This one is read by
# filechk_defaultenv.h, which only strips '#' lines and blank lines; the
# ENV_SOURCE_FILE arm runs the file through cpp instead. So the file uses '#'
# comments, and switching arms would need it rewritten.
#
# The path is relative to the U-Boot source tree, so nothing here points at a
# build directory - which is the failure that has to be avoided. Pointed at a
# generated file, this option silently loses the environment on the next clean
# build, and only reading the strings back out of the binary catches it.
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/ingenic/isvp-t41/isvp-t41nq.env"

# Ingenic T41 pad and USB-PHY init, as the stock SPL performs it.
#
# The option exists in the tree but is default n and is selected nowhere, so a
# build of the tree as committed produces a u-boot whose on-board RTL8733BU
# drops off the USB bus about two seconds after enumeration and whose SD slot
# never completes ACMD41. u-boot itself boots fine either way, which is what
# makes the omission easy to miss - the symptoms land in Linux, a layer away
# from the cause.
#
# Verified by disassembly: the reference binary running on the camera contains
# the pad-init writes, a build without this option does not.
CONFIG_T41_VENDOR_PAD_INIT=y

# Autoboot the way OpenIPC does it, compared against OpenIPC/u-boot-gk7205v200
# - a known-working OpenIPC bootloader. Deliberately not OpenIPC/u-boot-t41,
# which is unfinished and flagged dangerous to flash, so its choices are not
# evidence of anything.
#
# Goke has AUTOBOOT_KEYED off and BOOTDELAY=2: plain "hit any key to stop
# autoboot", two seconds. That is also why Ctrl-C works there - any key does.
# An earlier revision used AUTOBOOT_KEYED with ENTER as a stop string, on the
# reasoning that a one second window is hard to hit. That is better behaviour
# in isolation and still wrong here: the point is to match what an OpenIPC user
# already knows, and two seconds of any key is easier to hit anyway.
# CONFIG_AUTOBOOT_KEYED is not set
CONFIG_BOOTDELAY=2
CONFIG_SYS_PROMPT="OpenIPC # "

# The environment deliberately carries no ethaddr, because a shared default
# would put one MAC on every camera flashed with this image, and because
# arch/mips/mach-xburst/ethaddr.c derives a stable per-unit address from the
# SoC's eFUSE chip serial - but only when the environment does not already
# provide one.
#
# So on a fused part this option never fires: XBURST_MAC_FROM_EFUSE runs from
# misc_init_r(), before the network stack, and always leaves a valid ethaddr
# behind. It is kept as the backstop for an unfused part and for the case where
# the eFUSE path is ever disabled - without it u-boot would have no address at
# all and tftp would not run, which matters precisely when it is needed most:
# recovering a board whose environment is blank. OpenIPC ships it on.
CONFIG_NET_RANDOM_ETHADDR=y

# Recovery and diagnosis over the network, which is the only route into this
# board once it is assembled - the case is metal and reaching the serial
# console means opening it.
#   TFTPPUT     - read the flash back out, so a partition can be saved before
#                 it is overwritten rather than only after it is lost. On this
#                 camera it is the only backup route there is: no SOIC
#                 programmer, and the one USB port is occupied by the wifi card.
#   FS_GENERIC  - load/ls without knowing the filesystem, so an SD card can be
#                 read whether it came formatted FAT or ext.
CONFIG_CMD_TFTPPUT=y
CONFIG_CMD_FS_GENERIC=y
